<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
<xs:element name="pedido">
    <xs:complexType>
        <xs:sequence>
            <xs:element name="tractor">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="componente" type=""/>
                        <xs:element name="fechaEntrega" type="xs:date"/>
                        <xs:element name="peso" type="xs:float"/>
                        <xs:element name="numeroSerie" type="xs:string"/>
                        <xs:element name="cantidad" type="xs:int"/>
                        <xs:element name="fecha">
                            <xs:complexType>
                                <xs:sequence> 
                                <xs:element name="fechaEntrega">
                                 <!--Elemento fechaEntrega con restricciones de tipo y formato  --> 
                                 <xs:complexType>
                                 <xs:simpleContent>
                                 <xs:extension base="xs:string">
                                 <xs:attribute name="mes" default="05">
                                 <xs:simpleType>
                                 <xs:restriction>
                                 <xs:enumeration value="anio"/>
                                 <xs:enumeration value="dia"/>
                                 </xs:restriction>
                                 </xs:simpleType>
                                 </xs:attribute>
                                 </xs:extension>
                                 </xs:simpleContent>
                                 </xs:complexType>
                                </xs:element>
                                <xs:element name="fragil" type="xs:string" /> 
                                <xs:element name="peso" type="xs:string"/>
                                <xs:element name="numeroSerie" type="xs:string"/>
                                <xs:element name="kmMaximos"  type="xs:string"/>
                                <xs:element name="cantidad" type="xs:string"/>
                            </xs:sequence> <!-- end of componente sequence -->
                            <xs:attribute name="referencia" type="xs:string"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence> <!-- end of tractor sequence -->
                <xs:attribute name="codigoFabricante" type="xs:string"/>
            </xs:complexType>
        </xs:element>
    </xs:sequence> <!-- end of pedido sequence-->
    <xs:attribute name="idPedido" type="xs:string"/>
    <xs:attribute name="fecha" type="xs:string"/>
</xs:complexType>
</xs:element>
</xs:schema>